# 八字排盘系统环境变量配置
# 复制此文件为 .env 并填入真实值

# 服务端口（Railway 会自动设置）
PORT=3000

# 数据库连接（Railway 绑定 PostgreSQL 插件后自动注入）
# 本地开发留空则使用 SQLite，Railway 部署会自动设置
DATABASE_URL=

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET=your-jwt-secret-key-here

# 管理员账号
ADMIN_USER=admin
ADMIN_PASSWORD=your-secure-password-here

# AI 大模型 API Key
DEEPSEEK_API_KEY=your-deepseek-api-key
DOUBAO_API_KEY=your-doubao-api-key
TONGYI_API_KEY=your-tongyi-api-key
